execute_process(
    COMMAND git describe --tags --dirty --long
    OUTPUT_VARIABLE PMG_VERSION
    OUTPUT_STRIP_TRAILING_WHITESPACE
)

string(REGEX MATCH "v([^-.]*)\\.([^-.]*)\\.([^-.]*)-([^-]*)-g([^-]*)-?([^-]*)?" CMAKE_MATCH ${PMG_VERSION})

set(PMG_VERSION_MAJOR ${CMAKE_MATCH_1})
set(PMG_VERSION_MINOR ${CMAKE_MATCH_2})
set(PMG_VERSION_PATCH ${CMAKE_MATCH_3})
set(PMG_BUILD_NUMBER ${CMAKE_MATCH_4})
set(PMG_COMMIT_HASH ${CMAKE_MATCH_5})
set(PMG_DIRTY_FLAG ${CMAKE_MATCH_6})
set(PMG_BUILD_TYPE ${BUILD_TYPE})

if ("${PMG_DIRTY_FLAG}" STREQUAL "")
    set(PMG_DIRTY_MARKER "")
else()
    set(PMG_DIRTY_MARKER "*")
endif()


set(PMG_VERSION_STRING "${PMG_VERSION_MAJOR}.${PMG_VERSION_MINOR}.${PMG_VERSION_PATCH}.${PMG_BUILD_NUMBER} (${PMG_COMMIT_HASH}${PMG_DIRTY_MARKER}) ${PMG_BUILD_TYPE}")

configure_file(${CMAKE_CURRENT_LIST_DIR}/version.cpp.in ${VERSION_OUT} @ONLY)