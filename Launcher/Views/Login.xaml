<Page x:Class="Updater.Views.Login"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Updater.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Login"
      >

    <DockPanel>
        <TextBlock FontSize="15" DockPanel.Dock="Bottom" Name="VersionText" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="Black" Margin="0,0,20,20"/>
        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,100,0">
            <Grid Margin="0, 0, 0, 20">
                <Grid.Resources>
                    <Style TargetType="{x:Type TextBox}">
                        <Setter Property="Margin" Value="4,4,4,4" />
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Label FontSize="20" HorizontalAlignment="Right" Grid.Row="0" Grid.Column="0" Content="PlayerName:"/>
                <TextBox FontSize="20" Grid.Row="0" Grid.Column="1" />
                <Label FontSize="20" HorizontalAlignment="Right" Grid.Row="1" Grid.Column="0" Content="Password:"/>
                <TextBox FontSize="20" Grid.Row="1" Grid.Column="1" />
            </Grid>
            <StackPanel Orientation="Vertical">
                <Button x:Name="LoginButton" Content="Checking For Updates" Width="350" Click="LoginButton_Click" FontWeight="Bold" FontSize="28" IsEnabled="False" Margin="0, 0, 0, 20" />
                <Button x:Name="RegisterButton" Content="Register" Width="350" Click="RegisterButton_Click" FontWeight="Bold" FontSize="28" IsEnabled="False"/>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Page>
