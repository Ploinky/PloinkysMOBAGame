<Page x:Class="Launcher.Views.Register"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Launcher.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Register">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <TextBox Name="PlayerNameTextBox" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
        <Button Grid.Row="2" Click="RegisterButton_Click" Name="RegisterButton" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Register"/>
    </Grid>
</Page>
