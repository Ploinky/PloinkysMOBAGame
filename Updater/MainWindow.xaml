<Window x:Class="Updater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Updater"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        ContentRendered="Window_ContentRendered"
        Title="Ploinky's MOBA Game Launcher" Height="450" Width="800">
    <Grid>
        <TextBlock Name="VersionText" VerticalAlignment="Bottom" HorizontalAlignment="Right" Foreground="White"/>
        <Button Name="PlayButton" Content="Checking For Updates" Click="PlayButton_Click" VerticalAlignment="Top" HorizontalAlignment="Center"  FontWeight="Bold" FontSize="28" Margin="0,383,0,0"/>
    </Grid>
</Window>
